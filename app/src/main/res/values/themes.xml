<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.AlphaAi" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/blue</item>
        <item name="colorPrimaryVariant">@color/blue200</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>

        <item name="android:fontFamily">@font/app_font_family</item>
        <item name="fontFamily">@font/app_font_family</item>
    </style>

    <!-- Window theme for MainActivity (Compose). Compose draws everything; this only sets the
         window colour so there is no flash before the first frame. Legacy screens keep
         Theme.AlphaAi. -->
    <style name="Theme.AlphaAi.Compose" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/shell_window_background</item>
    </style>

    <!-- Launch theme for MainActivity: the system splash screen stays until the start
         destination is decided, then the window switches to Theme.AlphaAi.Compose (FR-001). -->
    <style name="Theme.AlphaAi.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/shell_window_background</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/icon_app_4</item>
        <item name="postSplashScreenTheme">@style/Theme.AlphaAi.Compose</item>
    </style>

</resources>