<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />

    <application
        android:name=".AlphaAiApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/icon_app_4"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/icon_app_4"
        android:supportsRtl="true"
        android:theme="@style/Theme.AlphaAi"
        tools:targetApi="31">
        <activity
            android:name=".ui.main.history.search.SearchHistoryActivity"
            android:exported="false" />
        <activity
            android:name=".ui.main.tasks.stt.STTActivity"
            android:exported="false" />
        <activity
            android:name=".ui.main.tasks.doc.DOCActivity"
            android:exported="false" />
        <activity
            android:name=".ui.main.tasks.er.ERActivity"
            android:exported="false" />
        <activity
            android:name=".ui.main.tasks.ocr.OCRActivity"
            android:exported="false" />
        <activity
            android:name=".ui.main.tasks.gec.GECActivity"
            android:exported="false" />
        <activity
            android:name=".ui.main.tasks.wr.WRActivity"
            android:exported="false" />
        <activity
            android:name=".ui.main.home.HomeActivity"
            android:exported="false" />
        <!-- The launcher (spec 004): shows the splash screen until the start destination is
             known. Debug builds add a gallery launcher alias in src/debug. -->
        <activity
            android:name=".shell.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.AlphaAi.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <meta-data
            android:name="preloaded_fonts"
            android:resource="@array/preloaded_fonts" />
    </application>

</manifest>